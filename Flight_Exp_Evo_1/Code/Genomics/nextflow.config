// parameter initialization
params.genome       = ""
params.index        = ""
params.bqsr         = false
params.cohort       = ""
params.cpus_mapping = 22
params.cpus         = 6
params.col_metrics  = false
params.gpu          = true
params.run_all      = true
params.Rinterval    = "$PWD/make_intervals.R"

// slurm executions

trace {
    enabled = true
    trace.overwrite = true
    file = "trace"
}

report {
    enabled = true
    report.overwrite = true
    file = "report"
}

timeline {
    enabled = true
    timeline.overwrite = true
    file = "timeline"
}

executor {
    name = 'slurm'
    queueSize = 500
    pollInterval = '20 sec'
}

process {
   withName: "split_intervals|bwa_index|getMetrics|index_recal_bam|bigBQSR|merge_GVCFs|merge_Vcfs|sort_GVCFs" {
     executor = 'slurm'
     clusterOptions = '-p general \
			--cpus-per-task 6 \
			--mem=24G \
			-t 2-00:00 \
			--account general \
			-e slurm_errors.log'
   	}

	withName: "GenomicsDBImport|combine_gvcfs" {
     executor = 'slurm'
     clusterOptions = '-p general \
			--cpus-per-task 24 \
			--mem=128G \
			-t 2-00:00 \
			--account general \
			-e slurm_errors.log'
	}

	withName: "GenotypeGVCFs|CombineGVCFs" {
     executor = 'slurm'
     clusterOptions = '-p general \
			--cpus-per-task 6 \
			--mem=140G \
			-t 2-00:00 \
			--account general \
			-e slurm_errors.log'
	}

        withName: "SelectSNPs|SelectInDels|fltmarkSNP|fltmarkInDel|hdfltSNP|hdfltInDel|MergeSNPInDel" {
     executor = 'slurm'
     clusterOptions = '-p general \
                        --cpus-per-task 6 \
                        --mem=96G \
                        -t 2-00:00 \
                        --account general \
                        -e slurm_errors.log'
        }

	withName: "gather_vcfs" {
     executor = 'slurm'
     clusterOptions = '-p general \
			--cpus-per-task 6 \
			--mem=50G \
			-t 2-00:00 \
			--account general \
			-e slurm_errors.log'
	}

	withName: "haplotypecaller" {
     executor = 'slurm'
     clusterOptions = '-p general \
			--cpus-per-task 10 \
			--mem=20G \
			-t 2-00:00 \
			--account general \
			-e slurm_errors.log'
	}

	withName: "sort_bams|map_reads|snap-Align-Sort-deDup" {
     executor = 'slurm'
     clusterOptions = '-p general \
			--cpus-per-task 24 \
			--mem=96G \
			-t 2-00:00 \
			--account general \
			-e slurm_errors.log'
	}

	withName: "BQSR_spark|mark_duplicates|merge_bams|BaseRecalibrator|BQSR" {
     executor = 'slurm'
     clusterOptions = '-p general \
			--cpus-per-task 28 \
			--mem=144G \
			-t 2-00:00 \
			--account general \
			-e slurm_errors.log'
   	}

	withName: "parabricks" {
     executor = 'slurm'
     clusterOptions = '-p gpu \
                        --gres=gpu:A100:1 \
                        --mem=250G \
			--cpus-per-task 12 \
                        -t 2-00:00 \
                        --account general \
                        -e slurm_errors.log'

}
}
